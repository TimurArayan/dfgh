{
	"enable_tab_scrolling": false,
	"font_face": "Comic True Mono Tuned",
	"font_size": 18,
	"color_scheme": "MyBlack.sublime-color-scheme",
	"ignored_packages":
	[
		"Vintage",
	],
	"index_files": true,
	"theme": "Spacegray.sublime-theme",
	"caret_style": "smooth",
	"caret_extra_top": 0,
	"caret_extra_bottom": 0,
	/*"enable_tab_scrolling": false,*/
	

	"auto_complete_triggers":
	[
		{
			"characters": "<",
			"selector": "text.html, text.xml",
		},
		{
			"rhs_empty": true,
			"selector": "punctuation.accessor",
		},
		{
			"characters": "\\",
			"selector": "text.tex.latex",
		}
	],
}
